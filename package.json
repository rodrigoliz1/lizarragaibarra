{
  "name": "lizarraga-ibarra",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio institucional, CMS y portal jurídico privado de Lizárraga & Ibarra.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "verify": "npm run db:generate && npm run db:validate && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db": "npm run db:generate && npm run db:validate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "lawyer:create": "node --env-file-if-exists=.env --import tsx scripts/create-invited-account.ts --kind lawyer",
    "client:create": "node --env-file-if-exists=.env --import tsx scripts/create-invited-account.ts --kind client"
  },
  "keywords": [
    "legal",
    "nextjs",
    "lizarraga-ibarra"
  ],
  "author": "Lizárraga & Ibarra Abogados",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@getbrevo/brevo": "^6.0.2",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "postcss": "^8.5.25",
    "sharp": "$sharp"
  }
}
