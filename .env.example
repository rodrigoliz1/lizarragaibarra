# URL pública
NEXT_PUBLIC_SITE_URL=https://lizarragaibarra.com
AUTH_URL=https://lizarragaibarra.com

# Neon: usar la URL de aplicación para DATABASE_URL y la URL directa para migraciones.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Autenticación y protección de datos
AUTH_SECRET=replace-with-a-random-32-character-minimum-secret
DATA_ENCRYPTION_KEY_CURRENT=replace-with-a-32-byte-base64url-key
DATA_ENCRYPTION_KEY_VERSION=1
MFA_RECOVERY_CODE_PEPPER=replace-with-a-random-secret
RATE_LIMIT_SALT=replace-with-a-random-secret
RATE_LIMIT_PROVIDER=database

# Análisis de documentos: los archivos quedan en cuarentena mientras sea disabled.
FILE_SCANNER_PROVIDER=disabled
# Cuando ClamAV esté disponible, sustituya la línea anterior y configure:
# FILE_SCANNER_PROVIDER=clamav
# CLAMAV_HOST=clamav.example.internal
# CLAMAV_PORT=3310
# FILE_SCAN_CRON_SECRET=replace-with-a-random-secret-of-at-least-24-characters

# Correo transaccional
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=notificaciones@lizarragaibarra.com
EMAIL_FROM_NAME=Lizárraga & Ibarra Abogados
EMAIL_REPLY_TO=r.lizarraga@lizarragaibarra.com
BREVO_API_KEY=replace-with-provider-key

# Cloudflare R2 mediante API compatible con S3
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=li-private-documents
S3_PUBLIC_MEDIA_BUCKET=li-public-media
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Operación
CRON_SECRET=replace-with-a-random-secret
CONTACT_RECIPIENT_EMAIL=r.lizarraga@lizarragaibarra.com
